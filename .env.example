# ─────────────────────────────────────────────────────────
#  ECCAAC — Risk Scoring Engine
#  Environment Configuration Template
#  Copy to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────

# ── Service ───────────────────────────────────────────────
ECCAAC_HOST=0.0.0.0
ECCAAC_PORT=50051
ECCAAC_WORKERS=10
ECCAAC_LOG_LEVEL=INFO
ECCAAC_LOG_FORMAT=json          # json | pretty

# ── Model ─────────────────────────────────────────────────
ECCAAC_MODEL_PATH=./checkpoints/best_model.pt
ECCAAC_CHECKPOINT_DIR=./checkpoints
ECCAAC_USER_STATS_DIR=./user_stats
ECCAAC_PROFILES_DIR=./profiles

# ── Database (PostgreSQL) ─────────────────────────────────
ECCAAC_DB_HOST=localhost
ECCAAC_DB_PORT=5432
ECCAAC_DB_NAME=eccaac
ECCAAC_DB_USER=eccaac_service
ECCAAC_DB_PASSWORD=change_me_in_production

# ── Risk Thresholds ───────────────────────────────────────
ECCAAC_THRESHOLD_LOW=25.0
ECCAAC_THRESHOLD_ELEVATED=50.0
ECCAAC_THRESHOLD_HIGH=75.0
ECCAAC_SOFT_PHASE_DIVISOR=2.0

# ── Session Management ────────────────────────────────────
ECCAAC_SESSION_TIMEOUT_S=3600
ECCAAC_MAX_ACTIVE_SESSIONS=1000

# ── Adaptation ────────────────────────────────────────────
ECCAAC_ADAPT_MAX_RISK=40.0
ECCAAC_MIN_SEQUENCES_FOR_ADAPT=6

# ── Security (TLS — enable in production) ─────────────────
ECCAAC_TLS_ENABLED=false
ECCAAC_TLS_CERT_PATH=./certs/server.crt
ECCAAC_TLS_KEY_PATH=./certs/server.key
ECCAAC_TLS_CA_PATH=./certs/ca.crt
